@model EndPoints.Models.ErrorViewModel
@{
    Layout = null;
    var code = Model?.Code ?? 500;
    var title = Model?.Title ?? "مشکلی پیش آمد";
    var message = Model?.Message ?? "درخواست شما پرداز نشد.";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@title | پیشگامان ایده‌نگار</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #f4f3ff;
            color: #161616;
            font-family: Tahoma, "Segoe UI", system-ui, sans-serif;
        }

        .box {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 22px 48px rgba(32, 38, 46, .12);
            padding: 2.25rem 2rem;
            max-width: 460px;
            width: calc(100% - 2rem);
            text-align: center;
        }

        .code {
            font-size: 2.6rem;
            font-weight: 700;
            color: #7367f0;
            letter-spacing: .02em;
        }

        h1 { font-size: 1.15rem; margin: .25rem 0 .6rem; }

        p { font-size: .9rem; line-height: 1.9; color: #5b6070; margin: 0 0 1.4rem; }

        a {
            display: inline-block;
            background: #7367f0;
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            padding: .6rem 1.1rem;
            font-size: .86rem;
        }

        .req { display: block; margin-top: 1.1rem; font-size: .7rem; color: #9aa0b4; word-break: break-all; direction: ltr; }
    </style>
</head>
<body>
<main class="box">
    <div class="code" dir="ltr">@code</div>
    <h1>@title</h1>
    <p>@message</p>
    <a href="/">بازگشت به صفحه اول</a>
    @if (Model?.ShowRequestId is true)
    {
        <span class="req">کد پیگیری: @Model.RequestId</span>
    }
</main>
</body>
</html>

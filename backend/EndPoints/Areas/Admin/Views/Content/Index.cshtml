@model ContentListViewModel
@{
    ViewData["Title"] = "مدیریت محتوا";
}
<div class="col-12">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button></div>
    }
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div><h4 class="mb-1">مدیریت محتوا</h4><p class="text-muted mb-0">صفحات، تنظیمات سایت، نمونه‌کارها و سایر رکوردهای قابل ویرایش</p></div>
        <a class="btn btn-primary" asp-action="Edit">افزودن محتوا</a>
    </div>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>تعداد رکوردها: @Model.Entries.Count</span>
            <form method="get" class="d-flex align-items-center gap-2">
                <label for="type-filter" class="form-label mb-0">نوع</label>
                <select id="type-filter" name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">همه</option>
                    @foreach (var type in Model.Entries.Select(x => x.ContentType).Distinct().OrderBy(x => x))
                    {
                        <option value="@type" selected="@(Model.TypeFilter == type)">@type</option>
                    }
                </select>
                <noscript><button class="btn btn-sm btn-outline-primary" type="submit">فیلتر</button></noscript>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>کلید</th><th>نوع</th><th>عنوان فارسی / English</th><th>وضعیت</th><th>به‌روزرسانی</th><th class="text-nowrap">عملیات</th></tr></thead>
                <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">محتوایی برای نمایش وجود ندارد.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Entries)
                    {
                        <tr>
                            <td dir="ltr" class="text-start"><code>@item.ContentKey</code></td>
                            <td><span class="badge bg-label-info">@item.ContentType</span></td>
                            <td><div>@(item.TitleFa ?? "—")</div><small class="text-muted" dir="ltr">@(item.TitleEn ?? "—")</small></td>
                            <td><span class="badge @(item.IsPublished ? "bg-label-success" : "bg-label-secondary")">@(item.IsPublished ? "منتشر" : "پیش‌نویس")</span></td>
                            <td>@((item.UpdatedAtUtc ?? item.CreatedAtUtc).ToString("yyyy/MM/dd HH:mm"))</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-label-primary" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('این محتوا حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-label-danger" type="submit">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

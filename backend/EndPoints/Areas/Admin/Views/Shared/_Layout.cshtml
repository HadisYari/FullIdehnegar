<!DOCTYPE html>
<html class="light-style layout-menu-fixed layout-compact" data-assets-path="/Panel/assets/" data-template="horizontal-menu-template" data-theme="theme-default" dir="rtl" lang="fa">

<head>
	<meta charset="UTF-8" />
	<meta content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" name="viewport" />
	<title>   پنل مدیریت ایده نگار | @ViewData["Title"]</title>

	<!-- Favicon -->
	<link href="/Panel/assets/img/favicon/favicon.ico" rel="icon" type="image/x-icon" />
	<!-- Icons -->
	<link href="/Panel/assets/vendor/fonts/fontawesome.css" rel="stylesheet" />
	<link href="/Panel/assets/vendor/fonts/tabler-icons.css" rel="stylesheet" />
	<link href="/Panel/assets/vendor/fonts/flag-icons.css" rel="stylesheet" />
	<!-- Core CSS class="template-customizer-theme-css"-->
	<link href="/Panel/assets/vendor/css/rtl/core.css" rel="stylesheet" />
	<link href="/Panel/assets/vendor/css/rtl/theme-default.css" rel="stylesheet" />
	@* <link href="/Panel/assets/css/demo.css" rel="stylesheet" /> *@
	<!-- Vendors CSS -->
	@* <link href="/Panel/assets/vendor/libs/node-waves/node-waves.css" rel="stylesheet" /> *@
	<link href="/Panel/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" />
	@* <link href="/Panel/assets/vendor/libs/typeahead-js/typeahead.css" rel="stylesheet" /> *@
	@* <link href="/Panel/assets/vendor/libs/apex-charts/apex-charts.css" rel="stylesheet" /> *@
	@* <link href="/Panel/assets/vendor/libs/swiper/swiper.css" rel="stylesheet" /> *@
	<link href="/Panel/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
	<link href="/Panel/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" />
	<link href="/Panel/assets/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css" rel="stylesheet" />
	<!-- Page CSS -->
	@* <link href="/Panel/assets/vendor/css/pages/cards-advance.css" rel="stylesheet" /> *@
	<!-- Helpers -->
	<script src="/Panel/assets/vendor/js/helpers.js"></script>
	<!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js in the <head> section -->
	<!--? Template customizer: To hide customizer set displayCustomizer value false in config.js.  -->
	<script src="/Panel/assets/vendor/js/template-customizer.js"></script>
	<!--? Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->
	<script src="/Panel/assets/js/config.js"></script>
	<!-- Better experience of RTL -->
	<link href="/Panel/assets/css/rtl.css?v=1.1.1" rel="stylesheet" />
	<link href="~/panel/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
	<link href="~/panel/assets/vendor/libs/select2/select2.css" rel="stylesheet" />

	<link href="~/Panel/PersionDataPiker/Mh1PersianDatePicker.css" rel="stylesheet" />
	@await RenderSectionAsync("Styles", required: false)
</head>

<body>
	<!-- Layout wrapper -->
	<div class="layout-wrapper layout-navbar-full layout-horizontal layout-without-menu">
		<div class="layout-container">
			<!-- Navbar -->
			<nav class="layout-navbar navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
				<div class="container-xxl">
					<div class="navbar-brand app-brand demo d-none d-xl-flex py-0 me-4">
						<a class="app-brand-link gap-2" href="/">
							<span class="app-brand-logo demo">
								<img width="50" height="50" src="~/Panel/assets/img/favicon/favicon.ico" />
							</span>
							<span class="app-brand-text demo menu-text fw-bold">ایده نگار     </span>
						</a>
						<a class="layout-menu-toggle menu-link fs-8 text-large ms-auto d-xl-none" href="javascript:void(0);">
							<i class="ti ti-x ti-sm align-middle"></i>
						</a>
					</div>
					<div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
						<a class="nav-item  nav-link px-0 me-xl-4" href="javascript:void(0)">
							<i class="ti ti-menu-2 ti-sm"></i>
						</a>
					</div>
					<div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
						<ul class="navbar-nav flex-row align-items-center ms-auto">
							  
							<li class="nav-item dropdown-style-switcher dropdown me-2 me-xl-0">
								<a class="nav-link dropdown-toggle hide-arrow" data-bs-toggle="dropdown" href="javascript:void(0);">
									<i class="ti ti-md"></i>
								</a>
								<ul class="dropdown-menu dropdown-menu-end dropdown-styles">
									<li>
										<a class="dropdown-item" data-theme="light" href="javascript:void(0);">
											<span class="align-middle">
												<i class="ti ti-sun me-2"></i>
												روز
											</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item" data-theme="dark" href="javascript:void(0);">
											<span class="align-middle">
												<i class="ti ti-moon me-2"></i>
												شب
											</span>
										</a>
									</li>
									<li>
										<a class="dropdown-item" data-theme="system" href="javascript:void(0);">
											<span class="align-middle">
												<i class="ti ti-device-desktop me-2"></i>
												سیستم
											</span>
										</a>
									</li>
								</ul>
							</li>
						 

							<li class="nav-item navbar-dropdown dropdown-user dropdown">
								<a class="nav-link dropdown-toggle hide-arrow" data-bs-toggle="dropdown" href="javascript:void(0);">
									<div class="avatar avatar-online">
										<img class="h-auto rounded-circle" src="/Panel/assets/img/avatars/man-user-icon.png" />
									</div>
								</a>
								<ul class="dropdown-menu dropdown-menu-end">
									<li>
										<a class="dropdown-item" href="/">
											<div class="d-flex">
												<div class="flex-shrink-0 me-3">
													<div class="avatar avatar-online">
														<img  class="h-auto rounded-circle" src="/Panel/assets/img/avatars/man-user-icon.png" />
													</div>
												</div>
												<div class="flex-grow-1">
													<span class="fw-semibold d-block mb-1"> @User.Identity.Name  </span>
													@* <small class="text-muted"> @User</small> *@
												</div>
											</div>
										</a>
									</li>
									<li>
										<div class="dropdown-divider"></div>
									</li>
								 

									<li>
										<form action="/Admin/Authentication/Logout" method="post">
											@Html.AntiForgeryToken()
											<button class="dropdown-item" type="submit">
												<i class="ti ti-logout me-2 ti-sm"></i>
												<span class="align-middle">خروج از حساب</span>
											</button>
										</form>
									</li>
								</ul>
							</li>
							<!--/ User -->
						</ul>
					</div>

				</div>
			</nav>
			<!-- / Navbar -->
			<!-- Layout container -->
			<div class="layout-page">
				<!-- Content wrapper -->
				<div class="content-wrapper">
					<!-- Menu -->
					<aside class="layout-menu-horizontal menu-horizontal menu bg-menu-theme flex-grow-0" id="layout-menu">
						<div class="container-xxl d-flex h-100">
							<ul class="menu-inner">
								<li class="menu-item"><a class="menu-link fs-8" href="/Admin"><i class="menu-icon tf-icons ti ti-smart-home"></i><div>داشبورد</div></a></li>
								<li class="menu-item"><a class="menu-link fs-8" href="/Admin/Content"><i class="menu-icon tf-icons ti ti-files"></i><div>مدیریت محتوا</div></a></li>
								<li class="menu-item"><a class="menu-link fs-8" href="/Admin/Content?type=portfolio"><i class="menu-icon tf-icons ti ti-briefcase"></i><div>نمونه‌کارها</div></a></li>
								<li class="menu-item"><a class="menu-link fs-8" href="/Admin/Content?type=testimonial"><i class="menu-icon tf-icons ti ti-message-circle"></i><div>دیدگاه‌ها</div></a></li>
								<li class="menu-item"><a class="menu-link fs-8" href="/Admin/Contacts"><i class="menu-icon tf-icons ti ti-mail"></i><div>پیام‌های تماس</div></a></li>
								<li class="menu-item"><a class="menu-link fs-8" href="/" target="_blank" rel="noopener"><i class="menu-icon tf-icons ti ti-world"></i><div>مشاهده سایت</div></a></li>
							</ul>
						</div>
					</aside>
					<div class="container-xxl pt-0 flex-grow-1 container-p-y">
						<div class="row">


							@RenderBody()
						</div>
					</div>

					<!--/ Content -->
					<!-- Footer -->
					<footer class="content-footer footer bg-footer-theme">
						<div class="container-xxl">
							<div class="footer-container d-flex align-items-center justify-content-between py-2 flex-md-row flex-column">
								<div>
									©2026
									ارائه شده توسط

									<a class="fw-medium" href="http://idehnegar.co/" target="_blank">ایده نگار</a>
								</div>

							</div>
						</div>
					</footer>
					<!-- / Footer -->
					<div class="content-backdrop fade"></div>
				</div>
				<!--/ Content wrapper -->
			</div>
			<!--/ Layout container -->
		</div>
	</div>
	<!-- Overlay -->
	<div class="layout-overlay layout-menu-toggle"></div>
	<!-- Drag Target Area To SlideIn Menu On Small Screens -->
	<div class="drag-target"></div>
	<!--/ Layout wrapper -->
	<!-- Core JS -->
	<!-- build:js assets/vendor/js/core.js -->
	<script src="/Panel/assets/vendor/libs/jquery/jquery.js"></script>
	<script src="/Panel/assets/vendor/libs/popper/popper.js"></script>
	<script src="/Panel/assets/vendor/js/bootstrap.js"></script>
	<script src="/Panel/assets/vendor/libs/node-waves/node-waves.js"></script>
	<script src="/Panel/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
	<script src="/Panel/assets/vendor/libs/hammer/hammer.js"></script>
	@* <script src="/Panel/assets/vendor/libs/i18n/i18n.js"></script> *@
	<script src="/Panel/assets/vendor/libs/typeahead-js/typeahead.js"></script>
	<script src="/Panel/assets/vendor/js/menu.js"></script>
	<!-- endbuild -->
	<!-- Vendors JS -->
	@* <script src="/Panel/assets/vendor/libs/apex-charts/apexcharts.js"></script> *@
	@* <script src="/Panel/assets/vendor/libs/swiper/swiper.js"></script> *@
	<script src="/Panel/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
	<script src="/Panel/assets/vendor/libs/datatables-bs5/i18n/fa.js"></script>
	<!-- Main JS -->
	<script src="/Panel/assets/js/main.js"></script>
	<!-- Page JS -->
	@* <script src="/Panel/assets/js/dashboards-analytics.js"></script> *@

	<script src="~/panel/assets/vendor/libs/select2/select2.js"></script>
	<script src="~/panel/sweetalert2/sweetalert2.min.js"></script>
	@* @await Html.PartialAsync("_pluginHoldOn") *@
	@await Html.PartialAsync("_ValidationScriptsPartial")

	<script src="~/panel/custome/js/persionformatfunctionpartail.js"></script>
	<link href="~/panel/custome/css/styledatatable.css" rel="stylesheet" />
	<link href="~/panel/custome/css/file-uploader.css" rel="stylesheet" />

	<!-- کلاینت مرکزی HTTP و سرویس‌های API -->
	<script src="~/panel/custome/js/api-client.js"></script>
	<script src="~/panel/custome/js/api-services.js"></script>
	<!-- کامپوننت سراسری آپلود فایل -->
	<script src="~/panel/custome/js/file-uploader.js"></script>

	<script>
		// فعال‌سازی تب بر اساس پارامتر ?tab= در آدرس (برای صفحات Master-Detail)
		$(function () {
			var tab = new URLSearchParams(window.location.search).get('tab');
			if (tab) {
				var trigger = document.querySelector('[data-bs-target="#tab-' + tab + '"]');
				if (trigger) new bootstrap.Tab(trigger).show();
			}
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>


 

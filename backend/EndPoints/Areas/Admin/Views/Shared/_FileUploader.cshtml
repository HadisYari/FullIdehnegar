@model EndPoints.Areas.Admin.Models.AdminFieldModel
@{
    // Mirrors the contract of wwwroot/Panel/custome/js/file-uploader.js.
    var accept = ".jpg,.jpeg,.png,.gif,.webp,.avif,.svg,.ico"; // must match UploadController.AllowedExtensions
    var maxSize = 6 * 1024 * 1024;
}
<div class="file-uploader" data-fu-accept="@accept" data-fu-max-size="@maxSize">
    <input type="hidden" class="fu-value" name="@Model.Property" id="fld_@Model.Property" value="@Model.Value" />

    <div class="fu-dropzone">
        <div class="fu-empty">
            <i class="ti ti-cloud-up"></i>
            <span>تصویر را اینجا رها کنید یا برای انتخاب کلیک کنید</span>
            <small class="fu-hint" dir="ltr">فرمت‌های مجاز: @accept | حداکثر حجم: ۶ مگابایت</small>
        </div>

        <div class="fu-preview d-none">
            <img class="fu-preview-img" alt="پیش‌نمایش تصویر انتخاب‌شده" loading="lazy" />
            <div class="fu-path small text-muted text-truncate" dir="ltr"></div>
            <div class="fu-actions">
                <button type="button" class="btn btn-sm btn-label-primary fu-change">تغییر تصویر</button>
                <button type="button" class="btn btn-sm btn-label-danger fu-remove">حذف</button>
            </div>
        </div>

        <input class="fu-input d-none" type="file" accept="@accept" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Value))
    {
        <a class="fu-open small" href="@Model.Value" target="_blank" rel="noopener">مشاهده تصویر در سایت</a>
    }
</div>

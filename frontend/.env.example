# Copy to .env.local in development or .env in production.
# This variable is consumed only by server-side Next.js code and is never used
# as a browser fetch URL. Set it at build and runtime so the /uploads rewrite is included.
CMS_API_URL=http://localhost:5100

# Public canonical URL used by Next.js metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://idehnegar.co

# Optional contact email delivery from the Next.js contact proxy.
# Contact messages are persisted in the backend SQL database when CMS_API_URL is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@idehnegar.co
CONTACT_FROM_EMAIL=

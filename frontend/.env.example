# Copy this file to .env.local (development) or .env (production) and fill in real values.
# Never commit .env or .env.local to git.

# --- Admin panel (/admin) ---
# Username you'll type in on the /admin/login page.
ADMIN_USERNAME=admin

# Generate with: node scripts/hash-password.mjs "YourStrongPassword"
ADMIN_PASSWORD_HASH=5994471abb01112afcc18159f6cc74b4f511b99806da59b3caf5a9c173cacfc5

# A long random string used to sign admin session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Contact form email delivery (optional) ---
# If left empty, submissions are still saved to src/data/messages.json
# and visible in /admin/messages, but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@idehnegar.co
CONTACT_FROM_EMAIL=

# --- Site URL (used for canonical links, sitemap, structured data) ---
NEXT_PUBLIC_SITE_URL=https://idehnegar.co

# ── اتصال به بک‌اند (EndPoints) ─────────────────────────────────
# آدرس پایهٔ API بدون اسلش انتهایی. خالی = سایت کاملاً آفلاین/فایل‌محور کار می‌کند.
# مثال پروداکشن: https://api.idehnegar.co  |  لوکال (dotnet run): http://localhost:5100
CMS_API_URL=
# راز مشترک با Site:RevalidateSecret در backend/EndPoints/appsettings.json
CMS_REVALIDATE_SECRET=
# مدت کش ISR برای پاسخ‌های API (ثانیه)
CMS_REVALIDATE_SECONDS=60
# مهلت زمان هر درخواست به API (ثانیه) — بعد از آن دادهٔ محلی جایگزین می‌شود
CMS_TIMEOUT_MS=4000
